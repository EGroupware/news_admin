<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="news_admin.cats.rows" template="" lang="" group="0" version="1.9.001">
		<grid width="100%">
			<columns>
				<column width="25%"/>
				<column width="52%"/>
				<column width="60"/>
				<column width="80"/>
				<column width="120"/>
				<column width="80"/>
				<column width="20%"/>
			</columns>
			<rows>
				<row class="th">
					<et2-nextmatch-sortheader  label="Name" id="name"></et2-nextmatch-sortheader>
					<et2-nextmatch-sortheader  label="Description" id="description"></et2-nextmatch-sortheader>
					<et2-nextmatch-sortheader  label="Read permissions" id="owner"></et2-nextmatch-sortheader>
					<et2-nextmatch-header  label="Write permissions" id="writable"></et2-nextmatch-header>
					<et2-vbox>
						<et2-vbox>
							<et2-nextmatch-sortheader  label="Last updated" id="news_date" sortmode="DESC"></et2-nextmatch-sortheader>
							<et2-nextmatch-header  label="Last imported" id="import_timestamp"></et2-nextmatch-header>
						</et2-vbox>
					</et2-vbox>
					<et2-nextmatch-sortheader  label="Count" id="num_news"></et2-nextmatch-sortheader>
					<et2-nextmatch-header  label="Import URL" id="import_url"></et2-nextmatch-header>
				</row>
				<row class="row $row_cont[class]">
					<et2-description  id="${row}[name]" href="news_admin.news_admin_gui.index&amp;cat_id=$row_cont[id]" target="news_admin"></et2-description>
					<et2-description  id="${row}[description]"></et2-description>
					<et2-select-account  id="${row}[owner]" readonly="true" emptyLabel="All users"></et2-select-account>
					<et2-select-account  id="${row}[cat_writable]" readonly="true" emptyLabel="All users"></et2-select-account>
					<et2-vbox>
						<et2-date-time  id="${row}[news_date]" readonly="true"></et2-date-time>
						<et2-date-time  id="${row}[import_timestamp]" readonly="true"></et2-date-time>
					</et2-vbox>
					<et2-description  align="center" id="${row}[num_news]"></et2-description>
					<et2-description  id="${row}[import_host]" href="$row_cont[import_url]" noLang="1" extraLinkTarget="_blank" extraLinkTitle="$row_cont[import_url]"></et2-description>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</et2-template>
	<et2-template  id="news_admin.cats.header" template="" lang="" group="0" version="1.9.001">
		<et2-button-icon  statustext="Add" image="add" id="add" onclick="window.open(egw::link('/index.php','menuaction=news_admin.news_admin_ui.cat&amp;appname=news_admin'),'_blank','dependent=yes,width=600,height=380,scrollbars=yes,status=yes'); return false;" noSubmit="true"></et2-button-icon>
	</et2-template>
	<et2-template  id="news_admin.cats" template="" lang="" group="0" version="1.9.001">
		<et2-template  template="news_admin.cats.header" slot="main-header"></et2-template>
		<et2-nextmatch  id="nm" template="news_admin.cats.rows"></et2-nextmatch>
		<!-- The "Change" read / write permission mass actions.  These used to be
		     <et2-box class="action_popup prompt"> boxes, upgraded into dialogs at runtime by the legacy
		     nm_open_popup(), whose buttons relied on the window.nm_popup_action/nm_popup_ids globals it set.
		     As real <et2-dialog>s none of that runs, so the buttons submit through
		     app.news_admin.submit_popup().  The inner <et2-box id="..._popup"> keeps the namespace
		     news_admin_ui::cats() reads: $content['reader_popup'][...] / $content['writer_popup'][...]. -->
		<et2-dialog  id="reader_popup_dialog" class="action_popup_dialog" title="Read permissions" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="reader_popup">
				<et2-select-account  id="reader" rows="4" class="action_popup-content" multiple="1" noLang="1" accountType="both"></et2-select-account>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Add" id="reader_popup[reader_action][add]" onclick="return app.news_admin.submit_popup(ev, widget, 'reader');"></et2-button>
			<et2-button  slot="footer" label="Delete" id="reader_popup[reader_action][delete]" onclick="return app.news_admin.submit_popup(ev, widget, 'reader');"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="reader_action_cancel" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
		<et2-dialog  id="writer_popup_dialog" class="action_popup_dialog" title="Write permissions" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="writer_popup">
				<et2-select-account  id="writer" rows="4" class="action_popup-content" multiple="1" noLang="1" accountType="both"></et2-select-account>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Add" id="writer_popup[writer_action][add]" onclick="return app.news_admin.submit_popup(ev, widget, 'writer');"></et2-button>
			<et2-button  slot="footer" label="Delete" id="writer_popup[writer_action][delete]" onclick="return app.news_admin.submit_popup(ev, widget, 'writer');"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="writer_action_cancel" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
		<et2-styles>
			.action_popup_dialog::part(panel) {
				width: 40em;
			}
			.action_popup-content {
				display: block;
				padding: 2ex;
			}
		</et2-styles>
	</et2-template>
</overlay>
