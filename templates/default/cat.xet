<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="news_admin.cat" template="" lang="" group="0" version="1.9.003" layout="edit">
		<et2-textbox  label="Name" id="cat_name" maxlength="150" span="all" required="1" noLang="1"></et2-textbox>
		<et2-select-cat  label="Parent" span="all" id="cat_parent" application="news_admin" emptyLabel="None" globalCategories="1"></et2-select-cat>
		<et2-ai  span="all"><et2-textarea  label="Description" class="et2-label-fixed" id="cat_description" rows="3" cols="64"></et2-textarea></et2-ai>
		<et2-select-account  label="Owner / Read permissions" id="cat_readable" rows="6" multiple="1" accountType="$cont[read_accounts]"></et2-select-account>
		<et2-select-account  label="Write permissions" id="cat_writable" rows="6" multiple="1" accountType="both"></et2-select-account>
		<et2-textbox  label="Import URL" statustext="URL of the RSS or Atom feed, empty for own news feed" id="import_url" span="all" hidden="!@import_available"></et2-textbox>
		<et2-select-number  label="Import every" id="import_frequency" min="1" max="24" suffix=" hours" emptyLabel="never" hidden="!@import_available"></et2-select-number>
		<et2-button  label="Import now" id="button[import]" hidden="!@import_available"></et2-button>
		<et2-hbox  hidden="!@import_available">
			<et2-select  label="Keep" class="et2-label-fixed" id="keep_imported" noLang="1"></et2-select>
			<et2-description  value="imported news items"></et2-description>
		</et2-hbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  label="Save" id="button[save]"></et2-button>
			<et2-button  label="Apply" id="button[apply]"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" onclick="window.close();"></et2-button>
			<et2-button  align="right" label="Delete" id="button[delete]" onclick="return confirm('Delete this category');"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
